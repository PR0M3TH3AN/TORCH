    "commands": ["npm test", "npm run lint"]
  },
  "funding": {
    "donatedCompute": true,
    "providers": ["openrouter", "routstr"],
    "lightningAddress": "project@example.com"
  },
  "contact": "https://github.com/example/wallet/discussions"
}
