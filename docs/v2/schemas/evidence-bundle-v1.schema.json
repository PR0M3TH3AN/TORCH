{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://torch.local/schemas/v2/evidence-bundle-v1.schema.json",
  "title": "TORCH Evidence Bundle",
  "description": "The normalized, signable record of one task run. Spec: DEVELOPMENT_NETWORK_SPEC.md §11; bridge T0.4. The four artifact families mirror what scripts/agent/verify-run-artifacts.mjs already enforces. The bundle's sha256 is published as a Nostr event; the bundle body goes to the campaign store.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "taskContractId",
    "campaignId",
    "milestoneId",
    "actor",
    "gitCommit",
    "promptBundleDigest",
    "startedAt",
    "completedAt",
    "validationResults",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "torch.evidence-bundle.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^ev_[a-z0-9-]{6,64}$"
    },
    "taskContractId": {
      "type": "string",
      "pattern": "^tc_[a-z0-9-]{6,64}$"
    },
    "campaignId": {
      "type": "string",
      "pattern": "^camp_[a-z0-9-]{6,64}$"
    },
    "milestoneId": {
      "type": "string",
      "pattern": "^ms_[a-z0-9-]{6,64}$"
    },
    "actor": {
      "type": "string",
      "description": "Durable worker identity (bridge §6.1); the lock's ephemeral key is separate",
      "pattern": "^npub1[02-9ac-hj-np-z]{58}$"
    },
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "promptBundleDigest": {
      "type": "string",
      "description": "sha256 over the compiled prompt bundle (spec §8)",
      "pattern": "^[0-9a-f]{64}$"
    },
    "startedAt": {
      "type": "integer",
      "minimum": 0
    },
    "completedAt": {
      "type": "integer",
      "minimum": 0
    },
    "validationResults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exitCode", "ok"],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "exitCode": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "ok": {
            "type": "boolean"
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context", "todo", "decisions", "testLogs"],
      "properties": {
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1, "maxLength": 512 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "todo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1, "maxLength": 512 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "decisions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1, "maxLength": 512 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "testLogs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": "string", "minLength": 1, "maxLength": 512 },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "severity", "summary"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 200 },
          "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
          "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "files": {
            "type": "array",
            "maxItems": 50,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    },
    "uncertainty": {
      "type": "string",
      "description": "Statement of remaining uncertainty (spec §1 evidence requirements)",
      "maxLength": 2000
    }
  }
}
