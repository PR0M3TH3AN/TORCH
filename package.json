{
  "name": "torch-agent-fleet",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "TORCH — a portable, provider-independent AI development fleet for Git repositories",
  "main": "src/cli.mjs",
  "exports": {
    ".": "./src/cli.mjs",
    "./adapters/claude": "./src/adapters/claude.mjs",
    "./adapters/codex": "./src/adapters/codex.mjs",
    "./canonical/local": "./src/canonical/local.mjs",
    "./checks": "./src/checks/service.mjs",
    "./control-plane": "./src/control-plane/service.mjs",
    "./kernel/analyze": "./src/kernel/analyze.mjs",
    "./kernel/git": "./src/kernel/git.mjs",
    "./kernel/install": "./src/kernel/install.mjs",
    "./kernel/worktrees": "./src/kernel/worktrees.mjs",
    "./integration": "./src/integration/service.mjs",
    "./mcp": "./src/mcp/tools.mjs",
    "./resources": "./src/resources/service.mjs",
    "./runtime/lifecycle": "./src/runtime/lifecycle.mjs"
  },
  "bin": {
    "torch": "./bin/torch.mjs",
    "torch-mcp": "./src/mcp/server.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PR0M3TH3AN/TORCH.git"
  },
  "keywords": [
    "agent-fleet",
    "worktrees",
    "multi-agent",
    "coordination",
    "orchestration",
    "cli"
  ],
  "license": "MIT",
  "files": [
    "bin/torch.mjs",
    "src/cli.mjs",
    "src/adapters/",
    "src/canonical/",
    "src/checks/",
    "src/control-plane/",
    "src/kernel/",
    "src/integration/",
    "src/mcp/",
    "src/resources/",
    "src/runtime/",
    "docs/PORTABLE_AGENT_FLEET_SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000 test/fleet/*.test.mjs",
    "torch": "node bin/torch.mjs",
    "check": "node --check bin/torch.mjs && node --check src/cli.mjs && node --check src/mcp/server.mjs",
    "format": "eslint src/adapters src/canonical src/checks src/control-plane src/integration src/kernel src/mcp src/resources src/runtime src/cli.mjs bin/torch.mjs test/fleet --fix",
    "lint": "eslint src/adapters src/canonical src/checks src/control-plane src/integration src/kernel src/mcp src/resources src/runtime src/cli.mjs bin/torch.mjs test/fleet"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "c8": "^11.0.0",
    "eslint": "^10.0.1",
    "globals": "^17.3.0"
  }
}
